[node name="HelpLabel" type="Label" parent="JoystickLayer"]
anchor_left = 0.20
anchor_top = 0.25
anchor_right = 0.80
anchor_bottom = 0.70
offset_left = 0.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
visible = false
text = "ထိန်းချုပ်နည်း: ဘယ်ဘက် joystick နဲ့ လမ်း လျှောက် / ကား မောင်း။ အပြေး ခလုတ် ဖိထား = ပြေး။ ခုန် = ခုန်။ ရွာသားနား ရောက်ရင် စကားပြော ခလုတ် ပေါ်မယ်။ ယာဉ်နား ရောက်ရင် စီးမည် ခလုတ် ပေါ်မယ်။ လေယာဉ် / ရဟတ်ယာဉ် မောင်းရင် အရှိန် + / - နဲ့ ယိမ်း ခလုတ်တွေ သုံးပါ။ ကင်မရာ ခလုတ် = ကင်မရာ လှည့်၊ ညာဘက်ခြမ်း ပွတ်ဆွဲရင်လည်း လှည့်ပါတယ်။ ဈေးနား ရောက်ရင် သစ်သီးဝယ် ခလုတ်၊ ရေတွင်းနား ရောက်ရင် ရေဆွဲ ခလုတ် ပေါ်မယ်။ ငှက်ပျောတောနား ရောက်ရင် ငှက်ပျောသီးခူး ခလုတ် ပေါ်မယ်။ ရွာမုခ်ဦးကို ဖြတ်ပြီး ငှက်ပျောသီး ၃ လုံး ခူးပါ။ မီးခလုတ် = ကား/ဆိုင်ကယ် မီးဖွင့်/ပိတ်။ ဝါးတံတားကို ဖြတ်ပြီး ဟင်္သာရုပ်တုနား ရောက်ရင် ဆုတောင်း ခလုတ် ပေါ်မယ်။ မြစ်မှာ လှေစီးလို့ရတယ်။ လက်ဖက်ရည်ဆိုင်နား ရောက်ရင် လက်ဖက်ရည်မှာစား ခလုတ်၊ ကျောင်းနား ရောက်ရင် စာအုပ်လှူ ခလုတ် ပေါ်မယ်။ စက်ဘီးလည်း စီးလို့ရတယ်။ လေယာဉ်/ရဟတ်ယာဉ်ပေါ်က အမြင့်မှာ ဆင်းရင် လေထီး အလိုအလို ပွင့်ပါတယ်။ သုံးဘီး စီးလို့ရတယ်။ ပွဲတော်နား ရောက်ရင် ဗုံတီး၊ မီးအိမ်ထွန်း၊ မုန့်ဝယ် ခလုတ်တွေ ပေါ်မယ်။ မြစ်ကမ်းနား ရောက်ရင် ငါးဖမ်း ခလုတ်၊ ဘုရားနား ရောက်ရင် အလှူပေး ခလုတ်၊ နွားနား ရောက်ရင် နို့ညှစ် ခလုတ်၊ နှမ်းခင်းနား ရောက်ရင် ရေလောင်း ခလုတ်၊ ကြက်အိမ်နား ရောက်ရင် အစာကျွေး ခလုတ် ပေါ်မယ်။ ကားမောင်းရင် ဟွန်း၊ စက်ဘီးစီးရင် ခေါင်းလောင်း ခလုတ် ပေါ်မယ်။ 📷 ခလုတ် = ဓာတ်ပုံရိုက် သိမ်းမယ်။ မိုး ခလုတ် = မိုးရွာ/ရပ်မယ်။ ဘောလုံးကို လမ်းလျှောက် တိုက်ရင် ကန်လို့ရတယ်၊ ဂိုးသွင်းရင် ဂိုးရေတွက်မယ်။ ဆင်လည်း စီးလို့ရတယ်။ ဘုရားမှာ ပန်းကပ်ပြီး စပါးစိုက်လို့ရတယ်။ ခုံတန်းမှာ နားရင် အားပြည့်တယ်။ အသံ ခလုတ် = အသံဖွင့်/ပိတ်။ မြင်းလည်း စီးလို့ရတယ်။ ရွှေဆိုင်နား ရောက်ရင် ရွှေဝယ် ခလုတ်၊ ကျောင်းစာပွဲနား ရောက်ရင် စာသင်ခန်း ခလုတ်၊ မြင်းနား ရောက်ရင် မြင်းအစာ ခလုတ် ပေါ်မယ်။ မြင်းစီးရင် မြင်းအော် ခလုတ် ပေါ်မယ်။ ညဈေးနား ရောက်ရင် ခေါက်ဆွဲဝယ်၊ အအေးဝယ် ခလုတ်တွေ၊ တည်းခိုခန်းနား ရောက်ရင် အိပ်၊ ဧည့်စာရင်းထိုး ခလုတ်တွေ ပေါ်မယ်။ ဒုတိယလှေနဲ့ ဒုတိယမြင်းလည်း စီးလို့ရတယ်။"

