extends StaticBody3D

# --- Authentic Myanmar Village Traditional Gate / Arch (ရွာဦးမုခ်ဦး 3D Model) ---

[sub_resource type="BoxShape3D" id="BoxShape3D_gate"]
size = Vector3(8.0, 5.0, 1.8)

# 2 Teak Columns
[sub_resource type="CylinderMesh" id="CylinderMesh_column"]
top_radius = 0.22
bottom_radius = 0.25
height = 4.2

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gate_teak"]
albedo_color = Color(0.35, 0.20, 0.10, 1) # Weathered Reddish Teak
roughness = 0.85

# Crossbeam & Burmese Spire Arch
[sub_resource type="BoxMesh" id="BoxMesh_beam"]
size = Vector3(7.4, 0.45, 0.6)

[sub_resource type="PrismMesh" id="PrismMesh_pyatthat"]
left_to_right = 0.5
size = Vector3(4.8, 1.4, 0.8)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gold_trim"]
albedo_color = Color(0.95, 0.78, 0.15, 1) # Gold Accent
metallic = 0.8

[node name="VillageGate" type="StaticBody3D"]

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.5, 0)
shape = SubResource("BoxShape3D_gate")

[node name="VisualMesh" type="Node3D" parent="."]

# Left Column
[node name="ColumnL" type="MeshInstance3D" parent="VisualMesh"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.2, 2.1, 0)
mesh = SubResource("CylinderMesh_column")
surface_material_override/0 = SubResource("StandardMaterial3D_gate_teak")

# Right Column
[node name="ColumnR" type="MeshInstance3D" parent="VisualMesh"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.2, 2.1, 0)
mesh = SubResource("CylinderMesh_column")
surface_material_override/0 = SubResource("StandardMaterial3D_gate_teak")

# Main Arch Crossbeam
[node name="Beam" type="MeshInstance3D" parent="VisualMesh"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4.0, 0)
mesh = SubResource("BoxMesh_beam")
surface_material_override/0 = SubResource("StandardMaterial3D_gate_teak")

# Decorative Pyatthat Top
[node name="PyatthatTop" type="MeshInstance3D" parent="VisualMesh"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4.8, 0)
mesh = SubResource("PrismMesh_pyatthat")
surface_material_override/0 = SubResource("StandardMaterial3D_gold_trim")

# Burmese Welcome 3D Signboard
[node name="WelcomeSign" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3.8, 0.35)
text = "မင်္ဂလာပါ — ရွှေရွာတော်မှ ကြိုဆိုပါ၏"
font_size = 32
outline_size = 10
modulate = Color(1, 0.9, 0.4, 1)
