; Engine configuration file.
config_version=5

[application]
config/name="Myanmar GTA Open World"
config/description="Myanmar-style GTA open world — Slice 1: village block, walk + car"
config/icon="res://icon.png"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; Slice 162: aspect "expand" (was the default "keep") — on
; wider-than-16:9 phones "keep" letterboxes the whole frame to
; 16:9 with side bars (proven: keep renders 1920x1080 centered in
; 2400x1080). "expand" fills the window with no distortion: the
; visible canvas widens (1600x720 at 2400x1080) so HUD corners
; reach the true screen edges and the camera sees more sideways.
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
; Committed (audit plan item 3): APK builds previously applied this
; locally at export time and reverted it. Without it the Android
; export fails blank. Keep it in the repo so fresh clones export clean.
textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[autoload]

SaveManager="*res://autoload/save_manager.gd"
MissionManager="*res://autoload/mission_manager.gd"
BackHandler161="*res://autoload/back_handler161.gd"
