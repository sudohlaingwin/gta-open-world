; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be also edited using any text editor.

config_version=5

[application]

config/name="Open World Mobile"
config/description="3D Open World Mobile Game for Android"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/glow/upscale_mode=1
textures/default_filters/anisotropic_filtering_level=2

[gui]

theme/custom_font="res://fonts/NotoSansMyanmar-Regular.ttf"

[autoload]

MyanmarFontAutoload="*res://scripts/myanmar_font_autoload.gd"
SaveManager="*res://scripts/save_manager.gd"
MissionManager="*res://scripts/mission_manager.gd"